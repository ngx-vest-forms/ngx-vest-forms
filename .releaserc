{
  "branches": [
    "master",
    {
      "name": "release/v1.x",
      "range": "1.x",
      "channel": "release-v1"
    },
    {
      "name": "release/v2.x",
      "range": "2.x",
      "channel": "release-v2"
    },
    {
      "name": "beta",
      "prerelease": true
    },
    {
      "name": "rc",
      "prerelease": true
    }
  ],
  "plugins": [
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/npm",
      {
        "pkgRoot": "dist/ngx-vest-forms"
      }
    ],
    "@semantic-release/github"
  ]
}
