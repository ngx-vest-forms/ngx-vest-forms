{
  "name": "ngx-vest-forms",
  "version": "0.0.0-development",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --config vitest.config.ts",
    "prepare": "husky",
    "build:app": "ng build examples --configuration=production --base-href=/ngx-vest-forms/",
    "build:lib": "ng build ngx-vest-forms --configuration=production",
    "build:ci": "npm run build:lib && npm run build:app",
    "postbuild:lib": "copyfiles README.md dist/ngx-vest-forms",
    "test:lib": "npm run -s test:lib:shard -- 1/3 && npm run -s test:lib:shard -- 2/3 && npm run -s test:lib:shard -- 3/3",
    "test:lib:shard": "vitest run --config vitest.config.ts projects/ngx-vest-forms --shard",
    "test:examples": "vitest run --config vitest.config.ts projects/examples",
    "test:ci": "npm run test:lib && npm run test:examples",
    "test:coverage": "ng test --coverage",
    "semantic-release": "semantic-release",
    "prettier:check": "prettier --check \"projects/**/*.{ts,js,json,css,scss,html}\"",
    "format": "prettier --write \"projects/**/*.{ts,js,json,css,scss,html}\"",
    "e2e": "ng e2e",
    "lint": "ng lint"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "21.2.12",
    "@angular/compiler": "21.2.12",
    "@angular/core": "21.2.12",
    "@angular/forms": "21.2.12",
    "@angular/platform-browser": "21.2.12",
    "@angular/platform-browser-dynamic": "21.2.12",
    "@angular/router": "21.2.12",
    "rxjs": "~7.8.2",
    "tslib": "~2.8.1",
    "vest": "~6.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.5.0",
    "@analogjs/vitest-angular": "^2.5.0",
    "@angular-devkit/build-angular": "21.2.10",
    "@angular/build": "21.2.10",
    "@angular/cli": "21.2.10",
    "@angular/compiler-cli": "21.2.12",
    "@commitlint/cli": "~20.5.3",
    "@commitlint/config-conventional": "~21.0.0",
    "@playwright/test": "1.59.1",
    "@semantic-release/git": "~10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/angular": "~19.2.1",
    "@testing-library/dom": "~10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "~14.6.1",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/eslint-plugin": "~1.6.16",
    "angular-eslint": "21.3.1",
    "copyfiles": "~2.4.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.5",
    "husky": "~9.1.7",
    "jsdom": "^29.1.1",
    "ng-packagr": "~21.2.3",
    "ngx-mask": "~21.0.1",
    "playwright": "~1.59.1",
    "playwright-ng-schematics": "^21.1.0",
    "postcss": "~8.5.14",
    "prettier": "~3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "~0.8.0",
    "semantic-release": "~25.0.3",
    "tailwindcss": "^4.2.4",
    "ts-node": "~10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ngx-vest-forms/ngx-vest-forms.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
