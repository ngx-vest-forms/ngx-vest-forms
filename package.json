  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "scripts": {
    "start": "nx run examples:serve",
    "build": "nx run-many --target=build",
    "build:lib": "nx run ngx-vest-forms:build --configuration=production",
    "build:app": "nx run examples:build --configuration=production --base-href=/ngx-vest-forms/",
    "build:ci": "pnpm run build:lib && pnpm run build:app",
    "test": "nx run-many --target=test",
    "test:browser": "nx run ngx-vest-forms:test-browser",
    "test:ci": "nx run-many --target=test",
    "lint": "nx run-many --target=lint,lint-templates",
    "e2e": "nx run examples-e2e:e2e",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,js,json,css,scss,html}\"",
    "prettier:check": "prettier --check \"{apps,packages}/**/*.{ts,js,json,css,scss,html}\"",
    "semantic-release": "semantic-release",
    "prepare": "husky"
  },
  "private": false,
