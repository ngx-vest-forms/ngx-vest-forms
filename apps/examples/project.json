{
  "name": "examples",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/examples/src",
  "prefix": "app",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath.base}"],
      "options": {
        "outputPath": {
          "base": "dist/examples"
        },
        "index": "apps/examples/src/index.html",
        "tsConfig": "apps/examples/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": ["apps/examples/src/favicon.ico", "apps/examples/src/assets"],
        "styles": ["apps/examples/src/styles.scss"],
        "scripts": [],
        "browser": "apps/examples/src/main.ts"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "650kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "6kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "tsconfig.spec.json",
        "runnerConfig": "vitest.config.ts",
        "coverageInclude": ["apps/examples/src/app/**/*.ts"],
        "coverageExclude": ["apps/examples/src/app/**/*.spec.ts"]
      }
    },
    "lint-templates": {
      "executor": "@angular-eslint/builder:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/examples/**/*.ts",
          "apps/examples/**/*.html"
        ],
        "eslintConfig": "apps/examples/eslint.config.mjs"
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "examples:build:production"
        },
        "development": {
          "buildTarget": "examples:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "serve-static": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": [
          {
            "command": "nx run examples:build:development",
            "forwardAllArgs": false
          },
          {
            "command": "vite preview --outDir dist/examples/browser --port {args.port} --strictPort",
            "forwardAllArgs": false
          }
        ],
        "parallel": false,
        "args": "--port=4400",
        "cwd": "{workspaceRoot}"
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "examples:build"
      }
    }
  }
}
