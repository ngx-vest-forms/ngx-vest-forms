{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ngx-vest-forms",
  "projectType": "library",
  "sourceRoot": "projects/ngx-vest-forms/src",
  "prefix": "lib",
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "options": {
        "project": "projects/ngx-vest-forms/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "projects/ngx-vest-forms/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "projects/ngx-vest-forms/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production",
      "outputs": [
        "{workspaceRoot}/dist/ngx-vest-forms"
      ]
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "tsconfig.spec.json",
        "runnerConfig": "vitest.config.ts"
      }
    },
    "lint": {
      "executor": "@angular-eslint/builder:lint",
      "options": {
        "lintFilePatterns": [
          "projects/ngx-vest-forms/**/*.ts",
          "projects/ngx-vest-forms/**/*.html"
        ],
        "eslintConfig": "projects/ngx-vest-forms/eslint.config.mjs"
      },
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "e2e": {
      "executor": "playwright-ng-schematics:playwright",
      "options": {
        "devServerTarget": "ngx-vest-forms:serve"
      },
      "configurations": {
        "production": {
          "devServerTarget": "ngx-vest-forms:serve:production"
        }
      }
    }
  }
}