{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": true,
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "associations": [
    {
      "files": ["*.html"],
      "language": "angular-html"
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".angular",
    ".github",
    ".agents/skills/angular-developer",
    ".agents/skills/link-workspace-packages",
    ".agents/skills/monitor-ci",
    ".agents/skills/nx-*",
    ".husky",
    ".vscode"
  ],
  "sortImports": {
    "partitionByNewline": true,
    "newlinesBetween": false
  }
}
